# ============================================================================
# OpenManus Production Environment Configuration
# ============================================================================
#
# Copy this file to .env and update with your actual values
# NEVER commit .env to version control
#
# ============================================================================

# ============================================================================
# Core API Configuration
# ============================================================================

# HTTP server port
PORT=8000

# Number of worker processes (CPU-intensive tasks)
# Recommendation: number of CPU cores
WORKERS=2

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ============================================================================
# LLM Provider Configuration
# ============================================================================

# OpenAI Configuration
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=https://api.openai.com/v1

# Azure OpenAI Configuration (alternative)
# AZURE_OPENAI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_MODEL=gpt-4o

# AWS Bedrock Configuration (alternative)
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...
# AWS_REGION=us-east-1
# BEDROCK_MODEL=anthropic.claude-3-sonnet-20240229-v1:0

# Anthropic Configuration (alternative)
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-3-sonnet

# Google Gemini Configuration (alternative)
# GOOGLE_API_KEY=AIza...
# GOOGLE_MODEL=gemini-2.0-flash

# Local LLM via Ollama (alternative)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=mistral

# ============================================================================
# OpenManus API Security
# ============================================================================

# API key for authentication (generate: python -c "import secrets; print(secrets.token_urlsafe(32))")
OPENMANUS_API_KEY=your-secure-api-key-change-in-production

# ============================================================================
# CORS & Network Security
# ============================================================================

# Comma-separated list of allowed origins
# IMPORTANT: In production, set to your actual domain(s)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000

# Comma-separated list of trusted hosts
TRUSTED_HOSTS=localhost,127.0.0.1,yourdomain.com,api.yourdomain.com

# ============================================================================
# Request Configuration
# ============================================================================

# Maximum request timeout in seconds (10-3600)
REQUEST_TIMEOUT=300

# Maximum retries for failed requests
MAX_RETRIES=3

# ============================================================================
# Database Configuration (optional)
# ============================================================================

# For persistence layer (future enhancement)
# DATABASE_URL=postgresql://user:password@localhost:5432/openmanus
# REDIS_URL=redis://localhost:6379/0

# ============================================================================
# Monitoring & Observability
# ============================================================================

# Sentry DSN for error tracking
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# OpenTelemetry configuration
# OTEL_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Datadog API key
# DATADOG_API_KEY=

# ============================================================================
# Feature Flags
# ============================================================================

# Enable debug mode (disable in production)
DEBUG=false

# Enable API documentation
ENABLE_DOCS=true

# Enable metrics endpoint
ENABLE_METRICS=true

# ============================================================================
# Email Configuration (for notifications/reports)
# ============================================================================

# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM_EMAIL=noreply@openmanus.dev

# ============================================================================
# Storage Configuration
# ============================================================================

# Local workspace directory for agent operations
WORKSPACE_DIR=./workspace

# Output directory for logs
LOG_DIR=./logs

# ============================================================================
# Advanced Configuration
# ============================================================================

# Number of retries for LLM API calls
LLM_MAX_RETRIES=3

# Temperature for LLM responses (0.0-2.0)
LLM_TEMPERATURE=0.0

# Max tokens for LLM responses
LLM_MAX_TOKENS=4096

# Agent execution timeout (seconds)
AGENT_TIMEOUT=300

# Tool execution timeout (seconds)
TOOL_TIMEOUT=60

# ============================================================================
# Browser Automation Configuration
# ============================================================================

# Enable browser automation tools
ENABLE_BROWSER_TOOLS=true

# Browser type: chromium, firefox, webkit
BROWSER_TYPE=chromium

# Headless mode (true for production)
BROWSER_HEADLESS=true

# ============================================================================
# Search Configuration
# ============================================================================

# Enable web search tools
ENABLE_SEARCH=true

# Search provider: google, bing, duckduckgo, baidu
SEARCH_PROVIDER=google

# Google Search API key (if using Google search)
# GOOGLE_SEARCH_API_KEY=...

# Bing Search API key (if using Bing search)
# BING_SEARCH_API_KEY=...

# ============================================================================
# Proxy Configuration (optional)
# ============================================================================

# HTTP_PROXY=http://proxy.company.com:8080
# HTTPS_PROXY=http://proxy.company.com:8080
# NO_PROXY=localhost,127.0.0.1,internal.company.com

# ============================================================================
# Notes
# ============================================================================
#
# - Never hardcode secrets in this file
# - Use environment-specific .env files for different deployments
# - Rotate API keys regularly
# - Keep LOG_LEVEL at INFO in production
# - Disable DEBUG in production
# - Update CORS_ORIGINS to your actual frontend domain
# - For Kubernetes deployments, use secrets instead of .env files
#
# ============================================================================
